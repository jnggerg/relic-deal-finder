<section class="flex items-center justify-between gap-4 border border-base-300 bg-base-200 p-4 sm:p-[22px]">
    <div class="min-w-0">
        @if (Run is not null)
        {
            <p class="text-[15px] text-base-content">Last refresh took @DisplayFormat.Duration(Run.Duration)</p>
            <p class="mt-1 text-[13px] text-muted">
                @DisplayFormat.Number(Run.PriceLookups) price lookups · @DisplayFormat.Number(Run.RelicCount) relics
                · finished @Run.FinishedAt.ToString("d MMM HH:mm")
            </p>
        }
        else
        {
            <p class="text-[15px] text-base-content">No refresh yet</p>
            <p class="mt-1 text-[13px] text-muted">Run one to pull prices from warframe.market.</p>
        }
    </div>
    <a href="refresh" class="shrink-0 whitespace-nowrap text-sm text-secondary hover:underline">View log →</a>
</section>

@code {
    // The latest successful refresh, null if there has never been one
    [Parameter] public RefreshRun? Run { get; set; }
}
