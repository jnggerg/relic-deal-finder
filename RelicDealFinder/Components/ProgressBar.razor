<div class="relative h-2 bg-base-300 @Class">
    <div class="absolute inset-y-0 left-0 bg-linear-to-r from-[#2a6b5c] to-secondary transition-all duration-300"
         style="width: @Percent%"></div>
    @if (ShowMarker)
    {
        <span class="absolute top-1/2 size-3 -translate-x-1/2 -translate-y-1/2 rotate-45 border-[1.5px] border-secondary bg-base-100 transition-all duration-300"
              style="left: @Percent%"></span>
    }
</div>

@code {
    // 0..1
    [Parameter] public double Value { get; set; }
    [Parameter] public bool ShowMarker { get; set; } = true;
    [Parameter] public string? Class { get; set; }

    private string Percent => (Math.Clamp(Value, 0, 1) * 100).ToString("0.##");
}
