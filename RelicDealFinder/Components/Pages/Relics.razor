@page "/relics"
@page "/relics/{Name}"
@implements IDisposable
@inject IRelicDashboardService DashboardService
@inject NavigationManager Navigation

<PageTitle>Relics | Relic Deal Finder</PageTitle>

@{ var rows = Rows; }
<section class="mt-8 border border-base-300 bg-base-200" role="table" aria-label="Relics by rare reward value">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-3 border-b border-base-300 p-4 sm:px-[22px]">
        <h1 class="text-xl text-base-content">Query relics</h1>
        <span class="font-mono text-xs text-muted">rare reward value</span>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Rare reward value range">
            @foreach (var (min, max) in Bands)
            {
                var on = (_min, _max) == (min, max);
                <button type="button" @onclick="() => (_min, _max) = (min, max)" aria-pressed="@on"
                        class="h-[34px] cursor-pointer border px-3 font-mono text-sm transition-colors @(on ? "border-secondary bg-secondary/10 text-base-content" : "border-base-300 text-muted hover:text-base-content")">
                    @(max is null ? $"≥ {min}" : $"{min}–{max}")<Plat />
                </button>
            }
        </div>
        <div class="flex h-[34px] items-center gap-2 border px-3 font-mono text-sm @(Bands.Contains((_min, _max)) ? "border-base-300" : "border-secondary")">
            <span class="text-muted">custom</span>
            <input type="number" min="0" placeholder="min" aria-label="Minimum rare reward value"
                   class="w-12 bg-transparent text-right text-base-content outline-none placeholder:text-muted/50"
                   @bind="_min" @bind:event="oninput" />
            <span class="text-muted">–</span>
            <input type="number" min="0" placeholder="max" aria-label="Maximum rare reward value (exclusive)"
                   class="w-12 bg-transparent text-right text-base-content outline-none placeholder:text-muted/50"
                   @bind="_max" @bind:event="oninput" />
            <Plat />
        </div>
        <span class="ml-auto font-mono text-sm text-secondary">@DisplayFormat.Count(rows.Count, "relic matches", "relics match")</span>
    </div>

    <div role="row" class="@ColumnsClass h-11 items-center border-b border-base-300 font-mono text-[11px] uppercase tracking-[0.15em] text-muted">
        <span role="columnheader">Relic</span>
        <span role="columnheader" class="hidden md:block">Rare reward</span>
        @SortHeader(SortKey.Rare, "Rare", "justify-end")
        @SortHeader(SortKey.IntEv, "Intact EV", "hidden justify-end md:flex")
        @SortHeader(SortKey.RadEv, "Radiant EV", "justify-end")
        <span role="columnheader"><span class="sr-only">Actions</span></span>
    </div>

    @if (rows.Count == 0)
    {
        <p class="px-4 py-12 text-center text-sm text-muted">No relics with a rare reward in this range</p>
    }
    @foreach (var relic in rows)
    {
        var viewing = relic == _viewing;
        <div role="row" @onclick="() => Open(relic)"
             class="@ColumnsClass min-h-[47px] cursor-pointer items-center border-b border-base-300 py-2 transition-colors last:border-b-0 @(viewing ? "bg-base-300/50 shadow-[inset_2px_0_0_var(--color-secondary)]" : "hover:bg-base-300/40")">
            <span role="cell" class="flex min-w-0 items-center gap-3">
                <TierBar Tier="relic.Tier" />
                <span class="truncate font-semibold text-base-content">@relic.Name</span>
            </span>
            <span role="cell" class="hidden min-w-0 items-center gap-2 text-sm text-base-content md:flex">
                <span class="inline-block size-[7px] shrink-0 rotate-45 bg-tier-axi"></span>
                <span class="truncate">@relic.Rare.Name</span>
            </span>
            <span role="cell" class="text-right font-mono text-sm text-peach tabular-nums">@if (relic.Rare.Price is { } p) { @p.ToString("0")<Plat /> } else { <span>–</span> }</span>
            <span role="cell" class="hidden text-right font-mono text-sm text-muted tabular-nums md:block">@relic.IntEv.ToString("0.0")<Plat /></span>
            <span role="cell" class="text-right font-mono text-sm text-base-content tabular-nums">@relic.RadEv.ToString("0.0")<Plat /></span>
            <span role="cell" class="text-right text-[13px] text-secondary">
                @if (viewing)
                {
                    <span>viewing</span>
                }
                else
                {
                    <a href="@Href(relic)" @onclick:stopPropagation class="hover:underline">open →</a>
                }
            </span>
        </div>
    }
</section>
<p class="mt-4 font-mono text-[11px] text-muted">EVs are 4-player radshare EVs: the expected price of the best reward out of the squad's 4 rolls, 7d VWAP, Forma counts as 0.</p>

<RelicDetailsModal Relic="_viewing" Orders="_orders" OrdersFailed="_ordersFailed" OnClose="Close" />

@code {
    [Parameter] public string? Name { get; set; }

    // each band runs up to the one above it; max is exclusive, null means unbounded
    private static readonly (int? Min, int? Max)[] Bands = [(50, null), (40, 50), (30, 40), (25, 30)];

    private const string ColumnsClass =
        "grid grid-cols-[minmax(0,1fr)_4rem_5rem_4.5rem] gap-x-3 px-4 " +
        "md:grid-cols-[minmax(7rem,1fr)_minmax(10rem,3fr)_5rem_6rem_6rem_5rem] md:gap-x-4 md:px-[22px]";

    private enum SortKey { Rare, IntEv, RadEv }

    private IReadOnlyList<RelicSummary> _relics = [];
    private int? _min = 40;
    private int? _max = 50;
    private SortKey _sortKey = SortKey.Rare;
    private bool _sortDesc = true;

    private RelicSummary? _viewing;
    private IReadOnlyList<Deal>? _orders;
    private bool _ordersFailed;
    private CancellationTokenSource? _ordersCts;

    protected override async Task OnInitializedAsync() =>
        _relics = await DashboardService.GetRelicsAsync();

    // the route drives the modal, so relic chips elsewhere can link straight to it
    protected override async Task OnParametersSetAsync()
    {
        var relic = _relics.FirstOrDefault(r => r.Name.Equals(Name, StringComparison.OrdinalIgnoreCase));
        if (relic == _viewing)
            return;

        _ordersCts?.Cancel();
        _ordersCts?.Dispose();
        _ordersCts = null;
        (_viewing, _orders, _ordersFailed) = (relic, null, false);
        // prerender would spend a rate-limited wfm request on a page that's about to re-render
        if (relic is null || !RendererInfo.IsInteractive)
            return;

        var cts = _ordersCts = new CancellationTokenSource();
        try
        {
            var orders = await DashboardService.GetSellOrdersAsync(relic, cts.Token);
            if (!cts.IsCancellationRequested)
                (_orders, _ordersFailed) = (orders ?? [], orders is null);
        }
        catch (OperationCanceledException)
        {
            // another relic was opened, or the page was left
        }
    }

    public void Dispose()
    {
        _ordersCts?.Cancel();
        _ordersCts?.Dispose();
    }

    private IReadOnlyList<RelicSummary> Rows
    {
        get
        {
            var filtered = _relics.Where(r => (r.Rare.Price ?? 0) is var p && p >= (_min ?? 0) && (_max is null || p < _max));
            Func<RelicSummary, double> key = _sortKey switch
            {
                SortKey.IntEv => r => r.IntEv,
                SortKey.RadEv => r => r.RadEv,
                _ => r => r.Rare.Price ?? 0,
            };
            return [.. _sortDesc ? filtered.OrderByDescending(key) : filtered.OrderBy(key)];
        }
    }

    private static string Href(RelicSummary relic) => $"relics/{Uri.EscapeDataString(relic.Name)}";

    private void Open(RelicSummary relic) => Navigation.NavigateTo(Href(relic));

    private void Close() => Navigation.NavigateTo("relics");

    private void ToggleSort(SortKey key)
    {
        _sortDesc = key != _sortKey || !_sortDesc;
        _sortKey = key;
    }

    private RenderFragment SortHeader(SortKey key, string label, string cellClass) =>
        @<span role="columnheader" class="flex @cellClass" aria-sort="@(key != _sortKey ? "none" : _sortDesc ? "descending" : "ascending")">
            <button type="button" @onclick="() => ToggleSort(key)"
                    class="cursor-pointer uppercase tracking-[0.15em] transition-colors @(key == _sortKey ? "text-peach" : "text-muted hover:text-base-content")">
                @label
                @if (key == _sortKey)
                {
                    <span aria-hidden="true">@(_sortDesc ? "▼" : "▲")</span>
                }
            </button>
        </span>;
}
