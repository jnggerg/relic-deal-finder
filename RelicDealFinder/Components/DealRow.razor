<li class="@GridClass h-[54px] border-b border-base-300 transition-colors hover:bg-base-300/40">
    <div class="flex min-w-0 items-center gap-3">
        <TierBar Tier="Deal.Tier" />
        <span class="flex min-w-0 flex-col leading-tight sm:flex-row sm:items-baseline sm:gap-2">
            <span tabindex="0" class="group relative min-w-0 cursor-default outline-none">
                <span class="block truncate font-semibold text-base-content group-hover:underline group-focus:underline">@Deal.RelicName</span>
                <span class="absolute left-0 top-full z-40 hidden pt-2 group-hover:block group-focus:block">
                    <RelicRewards Rewards="Deal.Rewards" />
                </span>
            </span>
            <span class="truncate text-xs text-muted">@Deal.Refinement</span>
        </span>
    </div>
    <a href="@($"https://warframe.market/items/{Deal.Slug}?type=sell")" target="_blank" rel="noopener noreferrer"
       class="hidden truncate text-sm text-muted hover:text-secondary hover:underline sm:block">@Deal.Seller ↗</a>
    <span class="text-right font-mono text-sm text-muted tabular-nums">@Deal.Ev.ToString("0.0")</span>
    <span class="text-right font-mono text-sm font-semibold text-base-content tabular-nums">@Deal.Ask.ToString()<Plat /></span>
    <span class="text-right font-mono text-sm text-secondary tabular-nums">+@Deal.Profit.ToString("0.0")<Plat /></span>
</li>

@code {
    public const string GridClass =
        "grid grid-cols-[1fr_3rem_3rem_4rem] items-center gap-x-2 sm:gap-x-3 px-4 sm:grid-cols-[1fr_7rem_4rem_4rem_5rem] sm:px-[22px]";

    [Parameter, EditorRequired] public Deal Deal { get; set; } = null!;
}
