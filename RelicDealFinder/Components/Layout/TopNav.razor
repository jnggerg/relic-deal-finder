@implements IDisposable
@inject IRelicDashboardService DashboardService
@inject RefreshCoordinator Coordinator
@inject NavigationManager Navigation

<header class="border-b border-base-300">
    <div class="mx-auto flex max-w-[1400px] flex-wrap items-stretch px-4 sm:px-7 md:h-[54px] md:flex-nowrap">
        <a href="" class="flex h-[54px] items-center gap-3 pr-8">
            <span class="inline-block size-3.5 rotate-45 border-[1.5px] border-primary"></span>
            <span class="text-[15px] font-light uppercase tracking-[0.15em] whitespace-nowrap">
                <span class="hidden sm:inline">Relic Exchange</span>
            </span>
        </a>

        <nav class="order-3 -mx-4 flex w-[calc(100%+2rem)] overflow-x-auto border-t border-base-300 sm:-mx-7 sm:w-[calc(100%+3.5rem)] md:order-none md:mx-0 md:w-auto md:border-t-0">
            @foreach (var (href, label) in Tabs)
            {
                <NavLink href="@href" Match="@(href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                         class="flex h-11 items-center whitespace-nowrap border-x border-b-2 border-transparent px-4 text-sm text-muted transition-colors hover:text-base-content md:h-full md:px-5 [&.active]:border-x-base-300 [&.active]:border-b-primary [&.active]:bg-base-200 [&.active]:text-base-content">
                    @label
                </NavLink>
            }
        </nav>

        <div class="ml-auto flex h-[54px] items-center gap-5">
            <div class="hidden items-center gap-2 font-mono text-xs text-muted tabular-nums lg:flex">
                @if (_state.IsRunning)
                {
                    <span class="size-1.5 animate-pulse-slow rounded-full bg-primary"></span>
                    <span class="text-peach">@(_state.CancelRequested ? "Cancelling…" : $"Refreshing · {(int)(_state.Progress * 100)}%")</span>
                }
                else if (_state.Phase == RefreshPhase.Failed && !Coordinator.LastRunCancelled)
                {
                    <span class="size-1.5 rounded-full bg-primary"></span>
                    <span class="text-primary">Refresh failed</span>
                }
                else if (_lastRefresh is not null)
                {
                    <span class="size-1.5 rounded-full bg-secondary"></span>
                    <span>Synced @_lastRefresh.FinishedAt.ToString("HH:mm") · @DisplayFormat.Number(_lastRefresh.RelicCount) relics</span>
                }
                else
                {
                    <span class="size-1.5 rounded-full bg-base-300"></span>
                    <span>Never synced</span>
                }
            </div>
            <button type="button"
                    class="whitespace-nowrap rounded-[3px] border border-secondary bg-transparent px-3.5 py-1.5 text-sm font-semibold text-secondary transition-colors enabled:hover:bg-secondary/10 disabled:cursor-not-allowed disabled:border-base-300 disabled:text-muted"
                    @onclick="StartRefresh" disabled="@_state.IsRunning">
                Refresh database
            </button>
        </div>
    </div>
</header>

@code {
    private static readonly (string Href, string Label)[] Tabs =
    [
        ("", "Dashboard"),
        ("deals", "Deals"),
        ("relics", "Relics"),
        ("top-parts", "Top parts"),
    ];

    private RefreshRun? _lastRefresh;
    private RefreshState _state = RefreshState.Idle;

    protected override async Task OnInitializedAsync()
    {
        _state = Coordinator.State;
        Coordinator.StateChanged += OnRefreshChanged;
        _lastRefresh = await DashboardService.GetLastRefreshAsync();
    }

    public void Dispose() => Coordinator.StateChanged -= OnRefreshChanged;

    private void OnRefreshChanged() =>
        _ = InvokeAsync(async () =>
        {
            var wasRunning = _state.IsRunning;
            _state = Coordinator.State;
            if (wasRunning && !_state.IsRunning)
                _lastRefresh = await DashboardService.GetLastRefreshAsync();
            StateHasChanged();
        });

    private void StartRefresh()
    {
        if (Coordinator.TryStart())
            Navigation.NavigateTo("refresh");
    }
}
