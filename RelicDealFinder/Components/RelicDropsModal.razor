@if (Part is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-base-100/80 p-4" @onclick="Close">
        <div @ref="_dialog" role="dialog" aria-modal="true" aria-labelledby="relic-drops-title" tabindex="-1"
             class="flex max-h-[80vh] w-full max-w-[640px] flex-col border border-base-300 bg-base-200 outline-none"
             @onclick:stopPropagation @onkeydown="OnKeyDown">
            <header class="flex items-start justify-between gap-4 border-b border-base-300 p-4 sm:p-[22px]">
                <div class="min-w-0">
                    <h2 id="relic-drops-title" class="text-xl text-base-content">@Part.Name</h2>
                    <p class="mt-1 font-mono text-xs uppercase tracking-[0.15em] text-muted">Dropped by @Part.DroppedBy.Count relics</p>
                </div>
                <button type="button" aria-label="Close"
                        class="cursor-pointer px-1 text-xl leading-none text-muted transition-colors hover:text-base-content"
                        @onclick="Close">
                    ×
                </button>
            </header>
            <div class="flex flex-wrap gap-2 overflow-y-auto p-4 sm:p-[22px]">
                @foreach (var drop in Part.DroppedBy)
                {
                    <RelicChip Drop="drop" />
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public PrimePart? Part { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _dialog;
    private PrimePart? _focusedFor;

    // move focus into the dialog when it opens, so Escape works straight away
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Part is not null && !ReferenceEquals(Part, _focusedFor))
            await _dialog.FocusAsync();
        _focusedFor = Part;
    }

    private Task Close() => OnClose.InvokeAsync();

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;
}
