<a href="@($"relics/{Uri.EscapeDataString(Drop.RelicName)}")"
   class="inline-flex h-7 items-center gap-1.5 whitespace-nowrap border border-base-300 px-2 text-[13px] transition-colors hover:border-muted">
    <TierDiamond Tier="Drop.Tier" />
    <span class="text-base-content">@Drop.RelicName</span>
    <span class="text-muted">@Drop.Rarity</span>
</a>

@code {
    [Parameter, EditorRequired] public RelicDrop Drop { get; set; } = null!;
}
